# Copy to deploy/.env.prod on the server (chmod 600). Generate secrets with: python tools/new-env.py --prod
SITE_DOMAIN=example.ir
API_DOMAIN=api.example.ir
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
OTP_HASH_KEY=
# Keep a copy OUTSIDE the server backups: without it client passwords can't be opened.
VAULT_MASTER_KEY=
SETUP_TOKEN=
SMS_PROVIDER=Kavenegar
SMS_API_KEY=
SMS_OTP_TEMPLATE=
SMS_LINE_NUMBER=
BALE_BOT_USERNAME=
BALE_TOKEN=
BALE_WEBHOOK_SECRET=
# Telegram through the gateway outside Iran (deploy/gateway). Empty = Telegram off.
TELEGRAM_BOT_USERNAME=
TELEGRAM_GATEWAY_URL=
TELEGRAM_GATEWAY_SECRET=
TELEGRAM_ARCHIVE_CHAT_ID=

# N2 — attendance devices (ZKTeco ADMS). Point the device's "Cloud Server / ADMS" at this name (port 80).
DEVICES_DOMAIN=

# N11 — office cameras (leave empty until the office box is installed; see deploy/cctv/README.md)
CCTV_DOMAIN=
CCTV_PUBLIC_URL=
CCTV_API_URL=http://10.66.0.2:9997
CCTV_RTSP_URL=rtsp://10.66.0.2:8554
CCTV_INTERNAL_USER=karnama
CCTV_INTERNAL_PASSWORD=
CCTV_HOOK_ADDRESS=10.66.0.2
CCTV_UPSTREAM=10.66.0.2:8889
CCTV_HOOK_BIND=10.66.0.1
