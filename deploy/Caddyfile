{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$API_DOMAIN} {
	encode zstd gzip
	# Large resumable uploads go through in 8 MB chunks; this is only the per-request cap.
	request_body {
		max_size 20MB
	}
	reverse_proxy api:8080
}
