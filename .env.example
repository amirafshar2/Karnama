# کارنما — نمونه‌ی تنظیمات. این فایل را به .env کپی کن و مقدارها را پر کن.
# هیچ مقدار واقعی را داخل گیت نگذار. کلید لازم خالی = برنامه اجرا نمی‌شود (fail-fast).

# Development = اجرای محلی. فایل .env فقط وقتی خوانده می‌شود که این مقدار صریحاً Development باشد.
ASPNETCORE_ENVIRONMENT=Development

# --- دیتابیس و کش ---
Database__Provider=PostgreSQL
ConnectionStrings__Default=Host=localhost;Port=5432;Database=karnama;Username=karnama;Password=;Maximum Pool Size=100
ConnectionStrings__Redis=localhost:6379
POSTGRES_PASSWORD=

# --- امنیت (حداقل ۳۲ کاراکتر تصادفی) ---
Jwt__SigningKey=
Jwt__Issuer=karnama
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
Otp__HashKey=
# Credential vault master key: base64 of 32 random bytes (tools/new-env.py makes it). Development falls back to storage/.vault-dev.key.
Vault__MasterKey=
Setup__Token=
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=https://localhost

# --- پشت Nginx (در Production الزامی؛ رنج شبکه‌ی داکر یا IP پراکسی) ---
ReverseProxy__KnownNetworks__0=
ReverseProxy__KnownProxies__0=

# --- محدودیت درخواست (پیش‌فرض‌ها مناسب‌اند؛ فقط برای تست تغییر بده) ---
RateLimits__OtpPerIpPer10Minutes=10
RateLimits__AuthPerIpPerMinute=30
RateLimits__UserBurst=60

# --- نصب ---
Seed__Mode=Demo            # Demo | Empty
DemoLogin__Enabled=false   # فقط در Development؛ در هر محیط دیگری روشن باشد = برنامه اجرا نمی‌شود

# --- پیامک ---
Sms__Provider=Console      # Console | Kavenegar | SmsIr
Sms__ApiKey=
Sms__OtpTemplate=

# --- پوش اندروید (اختیاری؛ هرگز تنها کانال) ---
Push__Provider=None        # None | <سرویس ایرانی> | Fcm
Push__ApiKey=

# --- فایل‌ها ---
Storage__Provider=Local    # Local | S3
Storage__S3__Endpoint=
Storage__S3__Bucket=
Storage__S3__AccessKey=
Storage__S3__SecretKey=
Upload__MaxVideoMb=500
Upload__MaxImageMb=20

# --- اپ اندروید ---
App__MinSupportedVersion=1.0.0
App__LatestVersion=1.0.0
App__DownloadUrl=

# --- فرانت (karnama-web/.env.local) ---
NEXT_PUBLIC_API_BASE=http://localhost:5080
NEXT_PUBLIC_HUB_BASE=http://localhost:5080
TWENTYFIRST_API_KEY=
API_KEY_21ST=

# --- لاگ ---
Seq__ServerUrl=http://localhost:5341

# ---- Notifications (M6). Leave empty to turn a channel off. ----
Sms__LineNumber=
Notify__PublicBaseUrl=http://localhost:3000
Notify__BaleBotUsername=
Messengers__BaleToken=
Messengers__BaleWebhookSecret=
# Telegram goes through Karnama.TelegramGateway outside Iran (N5).
Notify__TelegramBotUsername=
Messengers__TelegramGatewayUrl=
Messengers__TelegramGatewaySecret=
# Private channel for the files archive (the bot must be its admin), e.g. -1001234567890.
Notify__TelegramArchiveChatId=
